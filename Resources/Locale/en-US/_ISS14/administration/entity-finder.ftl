# entityfinder command
cmd-entityfinder-desc = Opens the entity finder: search entities by name, category and distance, see where they are, teleport to them.
cmd-entityfinder-help = Usage: entityfinder
cmd-entityfinder-server = This command cannot be run from the server console.
admin-player-actions-window-entity-finder = Entity Finder

# Window
entity-finder-title = Entity Finder
entity-finder-hint = Station grids are loaded at a random offset and rotation every round, so a map file's "pos" (the grid position) never matches "tp" coordinates (the world position). Both are listed here. Nearest first.
entity-finder-search = Search by name or prototype id...
entity-finder-radius = Radius (tiles, 0 = any):
entity-finder-same-map = Same map only
entity-finder-refresh = Search
entity-finder-admin-position = You: world { $world } (map { $map }) · grid { $grid }
entity-finder-admin-nowhere = You have no body to measure distances from.
entity-finder-count = { $total } entities found.
entity-finder-count-cut = Showing the nearest { $shown } of { $total } entities. Narrow the search to see the rest.
entity-finder-col-name = Entity
