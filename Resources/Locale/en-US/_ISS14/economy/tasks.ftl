# iss14: Economy — task boards
task-board-window-title = Task Board
task-board-header = { $department } · account balance { $balance } credits
task-board-header-no-access = Task Board
task-board-hint = Department members claim tasks. Delivery tasks: hand the goods to the board. Action tasks (healing, arrests, patrols) track themselves. Manual tasks are confirmed by a department head. Heads can post contracts paid from the department account.
task-board-no-access = The board shows tasks to department staff only. Your ID card does not belong to any department.
task-board-empty = No tasks posted.
task-board-reward-label = { $reward } cr
task-board-status-open = Open · posted by { $issuer }
task-board-status-claimed = Claimed by { $name } · posted by { $issuer }
task-board-status-done = Completed by { $name }
task-board-status-delivery = · delivered { $progress }/{ $target }
task-board-status-cleaning = · cleaned { $progress }/{ $target }
task-board-status-heal = · healed { $progress }/{ $target }
task-board-status-patrol = · beacons { $progress }/{ $target }
task-board-status-visit = · not there yet
task-board-status-progress = · progress { $progress }/{ $target }
task-board-patrol-beacon = Patrol: { $beacon } checked ({ $progress }/{ $target }).
task-board-claim = Claim
task-board-abandon = Abandon
task-board-confirm = Confirm done
task-board-remove = Remove
task-board-create-heading = Post a contract (paid from the department account)
task-board-create-heading-department = Post a contract for { $department } (paid from its account)
task-board-create-title = Title
task-board-create-description = Description
task-board-create-reward = Reward
task-board-create = Post
task-board-issuer-centcomm = Central Command
task-board-issuer-department = the department

task-board-announce = New task: { $title } ({ $reward } credits).
task-board-not-member = Only members of this department may take its tasks.
task-board-not-open = That task is not open.
task-board-not-yours = You did not claim that task.
task-board-not-head = Only a department head may do that.
task-board-cannot-confirm = Only claimed manual tasks can be confirmed.
task-board-self-confirm = You cannot confirm a task you claimed yourself. Another head has to sign it off.
task-board-no-worker = Nobody is working on that task.
task-board-full = The board is full.
task-board-invalid = Enter a title and a positive reward.
task-board-department-broke = The department account cannot cover that reward.
task-board-claimed = Claimed: { $title }
task-board-abandoned = Released: { $title }
task-board-cancelled = Removed: { $title }
task-board-created = Posted: { $title }
task-board-completed = Completed: { $title } — { $reward } credits paid.
task-board-delivered = Delivered { $progress }/{ $target }.
task-board-reward = Task reward: { $reward } credits for "{ $title }".

task-service-mop-title = Clean up { $count } messes
task-service-mop-desc = Mop puddles or scrub graffiti and dirt until { $count } messes are gone. Only real dirt counts - water you spread yourself doesn't.
task-service-scrub-title = Scrub { $count } stains
task-service-scrub-desc = Remove { $count } graffiti, stains or puddles anywhere on the station. Counts automatically while the task is claimed.
task-service-clean-bar-title = Clean the bar
task-service-clean-bar-desc = Make the bar presentable again. Confirmed by a head of staff.
task-service-trash-title = Collect { $count } pieces of trash
task-service-trash-desc = Hand { $count } pieces of trash in at the board.
task-service-burgers-title = Cook { $count } burgers
task-service-burgers-desc = Deliver { $count } burgers to the board for the hungry crew.
task-service-donuts-title = Bake { $count } donuts
task-service-donuts-desc = Deliver { $count } donuts to the board.
task-service-pizza-title = Bake { $count } pizzas
task-service-pizza-desc = Deliver { $count } whole pizzas to the board.
task-service-fruit-title = Harvest { $count } fruit
task-service-fruit-desc = Deliver { $count } pieces of fruit to the board.
task-service-flowers-title = Grow { $count } flowers
task-service-flowers-desc = Deliver { $count } flowers to the board.
task-service-banquet-title = CentComm banquet
task-service-banquet-desc = Central Command requests a proper meal for an inspection. The HoP confirms the banquet.

task-cargo-steel-title = Deliver { $count } steel sheets
task-cargo-steel-desc = Hand { $count } sheets of steel in at the board.
task-cargo-glass-title = Deliver { $count } glass sheets
task-cargo-glass-desc = Hand { $count } sheets of glass in at the board.
task-cargo-salvage-title = Salvage run
task-cargo-salvage-desc = Bring back something worthwhile from the debris field. The Quartermaster confirms.
task-cargo-deliver-title = Deliver a crate
task-cargo-deliver-desc = Deliver an approved order to the requesting department. The Quartermaster confirms.
task-cargo-plasma-title = CentComm plasma order: { $count } sheets
task-cargo-plasma-desc = Central Command buys { $count } sheets of plasma. Hand them in at the board.

task-engineering-repair-title = Repair hull damage
task-engineering-repair-desc = Fix a breach or damaged section. The Chief Engineer confirms.
task-engineering-lights-title = Replace broken lights
task-engineering-lights-desc = Replace the broken lights in a department. The Chief Engineer confirms.
task-engineering-solars-title = Wire the solars
task-engineering-solars-desc = Get a solar array online. The Chief Engineer confirms.
task-engineering-atmos-title = Fix atmospherics
task-engineering-atmos-desc = Restore proper air in a department. The Chief Engineer confirms.

task-medical-brutepacks-title = Supply { $count } brute packs
task-medical-brutepacks-desc = Hand { $count } brute packs in at the board.
task-medical-ointment-title = Supply { $count } ointments
task-medical-ointment-desc = Hand { $count } ointments in at the board.
task-medical-checkup-title = Crew check-up
task-medical-checkup-desc = Examine the crew of one department. The CMO confirms.
task-medical-restock-title = Restock medbay
task-medical-restock-desc = Refill the medical vendors and fridges. The CMO confirms.
task-medical-heal-brute-title = Treat { $count } brute damage
task-medical-heal-brute-desc = Patch up other crew members with bruise packs, gauze or other healing items that treat bruises and cuts. Counts automatically while claimed; healing yourself does not count.
task-medical-heal-burn-title = Treat { $count } burn damage
task-medical-heal-burn-desc = Treat burns on other crew members with ointment or other healing items. Counts automatically while claimed; healing yourself does not count.
task-medical-heal-any-title = Heal { $count } damage
task-medical-heal-any-desc = Heal { $count } points of damage of any kind on other people with healing items (packs, ointment, gauze, splints...). Counts automatically while claimed.
task-medical-house-call-title = House call: { $beacon }
task-medical-house-call-desc = Go to { $beacon } with a medkit and check on the people there. Completes as soon as you arrive at the beacon.

task-science-disk-title = Deliver { $count } research disks
task-science-disk-desc = Hand { $count } research disks in at the board.
task-science-anomaly-title = Harvest an anomaly
task-science-anomaly-desc = Scan and harvest an anomaly. The Research Director confirms.
task-science-borg-title = Build a cyborg
task-science-borg-desc = Assemble a working cyborg chassis. The Research Director confirms.

task-security-patrol-title = Patrol: { $count } station beacons
task-security-patrol-desc = Walk a round through the station and pass by { $count } different station beacons (the names on the nav map). They count automatically while the task is claimed.
task-security-check-area-title = Check on { $beacon }
task-security-check-area-desc = Go to { $beacon } and have a look around. Completes as soon as you arrive at the beacon.
task-security-detain-title = Detain a criminal
task-security-detain-desc = Arrest someone and set their status to Detained at a criminal records console. Counts when the record is changed.
task-security-catch-wanted-title = Catch a wanted person
task-security-catch-wanted-desc = Someone on the wanted list needs catching. Bring them in and set their record from Wanted to Detained at a criminal records console.
task-security-wanted-title = Put { $count } suspects on the wanted list
task-security-wanted-desc = Set { $count } people to Wanted at a criminal records console, with the crime as the reason. Counts when the record is changed.
task-security-contraband-title = Confiscate { $count } pieces of contraband
task-security-contraband-desc = Serious contraband is loose on the station. Track down syndicate gear, stolen high-value items or otherwise highly illegal goods and hand { $count } pieces in at this board. Each item is confiscated and destroyed on hand-in; everyday minor contraband does not count.
task-security-donuts-title = Donut run: { $count }
task-security-donuts-desc = Hand { $count } donuts in at the board. Morale matters.
