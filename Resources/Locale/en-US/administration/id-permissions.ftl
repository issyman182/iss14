# idpermissions command
cmd-idpermissions-desc = Opens the admin ID permissions editor for a player's ID card or a specific ID card entity.
cmd-idpermissions-help = Usage: idpermissions <username|userId|ID card entity uid>
cmd-idpermissions-server = This command cannot be run from the server console.
cmd-idpermissions-invalid-player = Unable to find that player.
cmd-idpermissions-player-offline = That player is not currently attached to an entity.
cmd-idpermissions-no-id = {$player} is not carrying an ID card.
cmd-idpermissions-completion = <username|userId|entity uid>

# Admin verb
admin-verb-id-permissions = Edit ID / Permissions

# Window
id-permissions-title = ID Permissions (Admin)
id-permissions-target-label = Editing:
id-permissions-invalid-target = The target ID card no longer exists.
id-permissions-icon-label = Job icon:
