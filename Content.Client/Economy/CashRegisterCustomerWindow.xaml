<!-- iss14: Economy -->
<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc cash-register-window-title}"
                      Resizable="True"
                      MinSize="360 260"
                      SetSize="400 320">
    <BoxContainer Orientation="Vertical" Margin="8" HorizontalExpand="True" VerticalExpand="True">
        <Label Name="DepartmentLabel" Text="-" StyleClasses="LabelSubText" />
        <PanelContainer StyleClasses="BackgroundDark" Margin="0 6 0 0" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="8">
                <Label Name="BillHeader" Text="{Loc cash-register-customer-no-bill}" StyleClasses="LabelHeading" />
                <ScrollContainer HScrollEnabled="False" VerticalExpand="True">
                    <Label Name="BillLines" />
                </ScrollContainer>
                <Label Name="TotalLabel" StyleClasses="LabelHeading" Margin="0 6 0 0" />
            </BoxContainer>
        </PanelContainer>
        <Label Text="{Loc cash-register-customer-hint}" StyleClasses="LabelSubText" Margin="0 6 0 0" />
        <Button Name="PayButton" Text="{Loc cash-register-pay-card}" Margin="0 6 0 0" HorizontalAlignment="Right" MinWidth="140" />
        <Label Name="MessageLabel" Margin="0 6 0 0" />
    </BoxContainer>
</controls:FancyWindow>
