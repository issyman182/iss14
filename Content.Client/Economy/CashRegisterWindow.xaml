<!-- iss14: Economy -->
<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc cash-register-window-title}"
                      Resizable="True"
                      MinSize="540 520"
                      SetSize="620 700">
    <BoxContainer Orientation="Vertical" Margin="8" HorizontalExpand="True" VerticalExpand="True">
        <PanelContainer StyleClasses="BackgroundDark" Margin="0 0 0 6">
            <BoxContainer Orientation="Horizontal" Margin="8">
                <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                    <BoxContainer Orientation="Horizontal">
                        <Label Name="DepartmentLabel" Text="-" VerticalAlignment="Center" />
                        <OptionButton Name="AccountOption" Visible="False" Margin="8 0 0 0" MinWidth="140" />
                    </BoxContainer>
                    <Label Name="CommissionLabel" Text="-" StyleClasses="LabelSubText" />
                </BoxContainer>
                <Button Name="RefreshButton" Text="{Loc cash-register-refresh}" VerticalAlignment="Center" />
            </BoxContainer>
        </PanelContainer>

        <TabContainer Name="Tabs" VerticalExpand="True" HorizontalExpand="True">
            <BoxContainer Name="SaleTab" Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True" Margin="4">
                <Label Text="{Loc cash-register-items-hint}" StyleClasses="LabelSubText" />
                <Label Text="{Loc cash-register-items-hint-2}" StyleClasses="LabelSubText" />
                <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
                    <LineEdit Name="SaleSearch" PlaceHolder="{Loc cash-register-search}" HorizontalExpand="True" />
                    <CheckBox Name="NearbyOnly" Text="{Loc cash-register-nearby-only}" Margin="6 0 0 0" />
                    <Button Name="FilterButton" Text="{Loc cash-register-filter}" Margin="6 0 0 0" />
                </BoxContainer>
                <Label Name="FilterLabel" StyleClasses="LabelSubText" Visible="False" Margin="0 2 0 0" />
                <ScrollContainer HScrollEnabled="False" VerticalExpand="True" HorizontalExpand="True" Margin="0 4 0 4">
                    <BoxContainer Name="ItemsBox" Orientation="Vertical" HorizontalExpand="True" />
                </ScrollContainer>

                <PanelContainer StyleClasses="BackgroundDark">
                    <BoxContainer Orientation="Vertical" Margin="8">
                        <Label Text="{Loc cash-register-manual-hint}" StyleClasses="LabelSubText" />
                        <BoxContainer Orientation="Horizontal" Margin="0 2 0 0">
                            <LineEdit Name="ManualName" PlaceHolder="{Loc cash-register-manual-name}" HorizontalExpand="True" />
                            <LineEdit Name="ManualPrice" PlaceHolder="{Loc cash-register-manual-price}" MinWidth="80" Margin="4 0 0 0" />
                            <LineEdit Name="ManualCount" Text="1" MinWidth="44" Margin="4 0 0 0" />
                            <Button Name="ManualAddButton" Text="{Loc cash-register-manual-add}" Margin="4 0 0 0" />
                        </BoxContainer>
                    </BoxContainer>
                </PanelContainer>

                <PanelContainer StyleClasses="BackgroundDark" Margin="0 6 0 0">
                    <BoxContainer Orientation="Vertical" Margin="8">
                        <Label Name="DraftHeader" Text="{Loc cash-register-draft-empty}" StyleClasses="LabelHeading" />
                        <BoxContainer Name="DraftLines" Orientation="Vertical" />
                        <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
                            <Label Name="DraftTotal" HorizontalExpand="True" />
                            <Button Name="ClearDraftButton" Text="{Loc cash-register-clear-draft}" Margin="0 0 4 0" />
                            <Button Name="CreateBillButton" Text="{Loc cash-register-create-bill}" />
                        </BoxContainer>
                    </BoxContainer>
                </PanelContainer>

                <PanelContainer StyleClasses="BackgroundDark" Margin="0 6 0 0">
                    <BoxContainer Orientation="Vertical" Margin="8">
                        <Label Name="BillHeader" Text="{Loc cash-register-no-open-bill}" StyleClasses="LabelHeading" />
                        <Label Name="BillLines" />
                        <Button Name="CancelBillButton" Text="{Loc cash-register-cancel-bill}" Visible="False" HorizontalAlignment="Right" />
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>

            <BoxContainer Name="PricesTab" Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True" Margin="4">
                <Label Text="{Loc cash-register-prices-hint}" StyleClasses="LabelSubText" />
                <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
                    <LineEdit Name="PriceSearch" PlaceHolder="{Loc cash-register-search}" HorizontalExpand="True" />
                    <CheckBox Name="PricesNearbyOnly" Text="{Loc cash-register-nearby-only}" Margin="6 0 0 0" />
                </BoxContainer>
                <ScrollContainer HScrollEnabled="False" VerticalExpand="True" HorizontalExpand="True" Margin="0 4 0 0">
                    <BoxContainer Name="PricesBox" Orientation="Vertical" HorizontalExpand="True" />
                </ScrollContainer>
            </BoxContainer>
        </TabContainer>

        <Label Name="MessageLabel" Margin="0 6 0 0" />
    </BoxContainer>
</controls:FancyWindow>
