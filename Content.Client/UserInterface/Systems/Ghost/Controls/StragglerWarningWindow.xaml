<DefaultWindow xmlns="https://spacestation14.io"
               Title="{Loc ghost-gui-straggler-title}"
               MinSize="500 250"
               SetSize="500 250">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True">
        <RichTextLabel Name="WarningLabel" VerticalExpand="True" />
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Name="ConfirmButton" Text="{Loc ghost-gui-straggler-confirm}" />
            <Button Name="CancelButton" Text="{Loc ghost-gui-straggler-cancel}" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
