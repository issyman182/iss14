<!-- iss14: Economy -->
<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc money-config-title}"
                      Resizable="True"
                      MinSize="440 420"
                      SetSize="480 500">
    <PanelContainer StyleClasses="BackgroundDark">
        <ScrollContainer HScrollEnabled="False" VerticalExpand="True" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" Margin="8" HorizontalExpand="True">

                <Label Text="{Loc money-config-bank}" StyleClasses="LabelHeading" />
                <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
                    <Label Text="{Loc money-config-max-balance}" MinWidth="200" />
                    <LineEdit Name="MaxBalanceEdit" MinWidth="120" />
                </BoxContainer>

                <Label Text="{Loc money-config-salary}" StyleClasses="LabelHeading" Margin="0 10 0 0" />
                <CheckBox Name="SalaryEnabledCheck" Text="{Loc money-config-salary-enabled}" />
                <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
                    <Label Text="{Loc money-config-salary-default}" MinWidth="200" />
                    <LineEdit Name="SalaryDefaultEdit" MinWidth="120" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
                    <Label Text="{Loc money-config-salary-multiplier}" MinWidth="200" />
                    <LineEdit Name="SalaryMultiplierEdit" MinWidth="120" />
                </BoxContainer>

                <Label Text="{Loc money-config-atm}" StyleClasses="LabelHeading" Margin="0 10 0 0" />
                <CheckBox Name="FingerprintCheck" Text="{Loc money-config-atm-fingerprint}" />
                <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
                    <Label Text="{Loc money-config-atm-limit}" MinWidth="200" />
                    <LineEdit Name="WithdrawLimitEdit" MinWidth="120" />
                </BoxContainer>
                <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
                    <Label Text="{Loc money-config-atm-fee}" MinWidth="200" />
                    <LineEdit Name="FeeEdit" MinWidth="120" />
                </BoxContainer>

                <Label Text="{Loc money-config-vending}" StyleClasses="LabelHeading" Margin="0 10 0 0" />
                <CheckBox Name="VendingPricesCheck" Text="{Loc money-config-vending-prices}" />
                <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
                    <Label Text="{Loc money-config-vending-multiplier}" MinWidth="200" />
                    <LineEdit Name="VendingMultiplierEdit" MinWidth="120" />
                </BoxContainer>

                <Label Text="{Loc money-config-chips}" StyleClasses="LabelHeading" Margin="0 10 0 0" />
                <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
                    <Label Text="{Loc money-config-chip-rate}" MinWidth="200" />
                    <LineEdit Name="ChipRateEdit" MinWidth="120" />
                </BoxContainer>

                <Label Name="StatusLabel" Margin="0 8 0 0" />
                <Label Text="{Loc money-config-hint}" StyleClasses="LabelSubText" Margin="0 8 0 0" />
            </BoxContainer>
        </ScrollContainer>
    </PanelContainer>
</controls:FancyWindow>
