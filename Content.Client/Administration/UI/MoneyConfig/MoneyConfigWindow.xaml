<!-- iss14: Economy -->
<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc money-config-title}"
                      Resizable="True"
                      MinSize="520 460"
                      SetSize="600 640">
    <PanelContainer StyleClasses="BackgroundDark">
        <BoxContainer Orientation="Vertical" Margin="8" HorizontalExpand="True" VerticalExpand="True">
            <TabContainer Name="Tabs" VerticalExpand="True" HorizontalExpand="True">
                <ScrollContainer Name="SettingsTab" HScrollEnabled="False" VerticalExpand="True" HorizontalExpand="True">
                    <BoxContainer Name="SettingsBox" Orientation="Vertical" HorizontalExpand="True" Margin="4" />
                </ScrollContainer>
                <BoxContainer Name="SalaryTab" Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True" Margin="4">
                    <Label Text="{Loc money-config-salary-table-hint}" StyleClasses="LabelSubText" />
                    <ScrollContainer HScrollEnabled="False" VerticalExpand="True" HorizontalExpand="True" Margin="0 4 0 0">
                        <BoxContainer Name="SalaryBox" Orientation="Vertical" HorizontalExpand="True" />
                    </ScrollContainer>
                </BoxContainer>
            </TabContainer>
            <Label Name="StatusLabel" Margin="0 6 0 0" />
            <Label Text="{Loc money-config-hint}" StyleClasses="LabelSubText" Margin="0 4 0 0" />
        </BoxContainer>
    </PanelContainer>
</controls:FancyWindow>
